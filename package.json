{
  "name": "proof-gatekeeper-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:proof": "tsx --test tests/prover.integration.test.ts",
    "replay": "tsx scripts/replay.ts",
    "artifacts:verify": "tsx scripts/artifacts.ts verify",
    "artifacts:download": "tsx scripts/artifacts.ts download",
    "vk:register": "tsx scripts/register-vk.ts",
    "testnet:smoke": "tsx scripts/testnet-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "snarkjs": "0.7.6",
    "zod": "4.6.7"
  },
  "overrides": {
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
