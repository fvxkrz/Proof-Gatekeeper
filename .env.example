# Secrets: set locally in your host's secret store. Never send these values in chat.
AGENT_GAMES_HMAC_SECRET=
KURIER_API_KEY=

# Testnet first. Set KURIER_VK_HASH only after confirming registration on testnet.
ZKVERIFY_NETWORK=testnet
KURIER_VK_HASH=
ALLOW_MAINNET=false

# Required before approvals: reviewed encoding from official documentation/accepted practice.
# No guessed implementation is included. Leave blank until that specification exists.
ENCODING_MODULE=
ENCODING_MODULE_SHA256=
# OPTIONAL: unverified field encoding for unscored REJECT-trap practice only.
# Never use for competition. Live host opt-in has no platform-accepted vector yet.
# PRACTICE_ENCODER=sha256-vk-modp-taskid-sha256-modp-v1

HOST=127.0.0.1
PORT=3000
AGENT_PATH=/agent
DB_PATH=./data/gatekeeper.sqlite
ARTIFACTS_DIR=./circuits
MAX_IN_FLIGHT=1
BODY_LIMIT_BYTES=65536
RESPONSE_BUDGET_MS=55000
PROOF_TIMEOUT_MS=15000
MAX_TASK_AGE_MS=60000
CLOCK_SKEW_MS=5000

# Your publicly resolvable DNS name for Caddy HTTPS.
AGENT_DOMAIN=
